# Variables NO secretas de Docker Compose (ADR-0010). Copiar a .env en la raiz solo si hace falta cambiarlas.
# Los secretos NO van aqui: cada servicio tiene su propio .env (backend/.env, backend/nlp_service/.env,
# backend/ml_service/.env), a partir de su .env.example.

# Modelo que sirve el servicio de ML: real | demo. Con Compose el valor por defecto es demo (ADR-0011): un modelo
# entrenado con datos SINTETICOS (reglas del equipo, ADR-0009): no es una estimacion clinica. Requiere haber
# ejecutado antes "docker compose run --rm ml_entrenar_demo". (El codigo del servicio, sin esta variable, usa real.)
ML_MODELO=demo

# Integracion backend -> ML (ADR-0011). ML_ENABLED se activa en backend/.env, no aqui.
ML_TIMEOUT=2.0
ML_DURACION_DEFECTO_ANIOS=6.5

# IP del proxy en el que confia el servicio NLP para X-Forwarded-For (limite de tasa por IP).
# En Azure: la IP del ingress. No uses "*" salvo que el servicio solo sea alcanzable por el proxy.
FORWARDED_ALLOW_IPS=127.0.0.1

# Puertos del HOST donde se publican el backend y el chatbot (por defecto 8000 y 8001). Cambialos si estan ocupados.
# El servicio de ML no publica ningun puerto.
BACKEND_PORT=8000
NLP_PORT=8001
