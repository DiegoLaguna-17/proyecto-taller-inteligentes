# GlucoTracker — backend de negocio. Copiar a backend/.env y completar con valores reales.
# Nunca commitear el .env real. Lo carga app/core/config.py (primero backend/data/.env si existe, luego backend/.env).
# El servicio de ML (backend/ml_service/.env.example) y el servicio NLP (backend/nlp_service/.env.example)
# tienen su propio .env: aquí no van sus variables.

# Supabase
SUPABASE_URL=
SUPABASE_KEY=

# Auth: hoy el login envía un OTP por correo y no emite token (ver design.md § Open Questions).
# Sin valor por defecto seguro: define un secreto largo y aleatorio.
JWT_SECRET=
JWT_ALGORITHM=HS256

# Segundo factor del login. true = el login envía el OTP por correo (comportamiento normal). false SOLO para pruebas
# E2E (ADR-0012): el login devuelve el rol sin OTP. Nunca poner false aquí ni en el compose principal.
OTP_ACTIVADO=true

# Correo (envío del OTP)
EMAIL_USER=
EMAIL_PASS=

# Integración con el servicio de ML (ADR-0011). Apagada por defecto: con ML_ENABLED=false el registro de glucosa del
# médico responde exactamente como antes. Para activarla: ML_ENABLED=true (el ML debe estar levantado con Compose).
ML_ENABLED=false
# Dirección INTERNA del servicio de ML (red_ml de Compose); nunca una URL pública.
ML_URL=http://ml_service:8002
# Tiempo máximo de espera al ML en segundos (sin reintentos; si se agota, el registro responde igual).
ML_TIMEOUT=2.0
# Duración de la diabetes que se asume (años) mientras la base no la tenga: mediana del conjunto sintético.
ML_DURACION_DEFECTO_ANIOS=6.5

# Lo lee Settings (core/config.py); el puerto real de uvicorn se pasa con --port.
PORT=
