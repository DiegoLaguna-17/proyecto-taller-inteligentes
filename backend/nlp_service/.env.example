# Servicio NLP de GlucoTracker — copiar a backend/nlp_service/.env y completar.
# Nunca commitear el .env real. Una variable vacía usa el valor por defecto
# documentado en app/config.py (las claves no tienen valor por defecto).
# Ver design.md § Servicio NLP (chatbot) Design.

# Proveedor LLM: gemini | fake
NLP_PROVIDER=
NLP_MODEL=
NLP_PROVIDER_API_KEY=
NLP_TIMEOUT_SECONDS=
NLP_ENFORCE_DISCLAIMER=

# Seguridad del endpoint (TASK-018)
CHATBOT_REQUIRE_AUTH=
CHATBOT_MAX_INPUT_CHARS=
CHATBOT_RATE_LIMIT_PER_MINUTE=
