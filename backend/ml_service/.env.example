# Servicio de ML de GlucoTracker — copiar a backend/ml_service/.env y completar.
# Nunca commitear el .env real. Una variable vacía usa el valor por defecto
# documentado en app/config.py.
# Ver design.md § Servicio de ML.

# Carpeta con modelo_hipoglucemia.pkl y modelo_hipoglucemia.json (por defecto app/artefactos/).
# Con Docker Compose no se usa: el compose fija ML_ARTEFACTOS_DIR=/artefactos (volumen ml_artefactos).
ML_ARTEFACTOS_DIR=
# DEBUG | INFO | WARNING | ERROR | CRITICAL (por defecto INFO)
ML_LOG_LEVEL=
# Documentación interactiva (/docs, /redoc, /openapi.json): true | false (por defecto false;
# con false responden 404). Solo para desarrollo: el servicio no es público.
ML_ENABLE_DOCS=
# Modelo que sirve el servicio: real | demo (por defecto real). "demo" es un modelo entrenado con
# datos SINTETICOS (reglas del equipo, ADR-0009): no es una estimacion clinica.
# Con Docker Compose se define con ML_MODELO en el .env de la raiz (docker-compose.yml lo pasa al
# contenedor y tiene prioridad sobre este archivo).
ML_MODELO=
