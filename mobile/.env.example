# Variables públicas de Expo (EXPO_PUBLIC_*). Copiar a mobile/.env, que NO se versiona (está en .gitignore).
# Se leen al iniciar el empaquetador: reinicia `npx expo start -c` después de cambiarlas.
#
# En un celular `localhost` es el propio celular. Usa la IP local de la PC que corre Docker, en la misma red Wi-Fi
# (en Windows: `ipconfig`, "Dirección IPv4"). Nunca subas tu IP real a git.
#
# IMPORTANTE: las URL van SIN el sufijo /api. La app ya agrega /api/... a cada ruta.
#   Correcto:   http://TU-IP-LOCAL:8000
#   Incorrecto: http://TU-IP-LOCAL:8000/api      (el front web usa este formato; aquí pediría /api/api/login -> 404)
# Si la dejas con /api, la app lo quita sola, pero escríbela bien.

# Backend de negocio (login, glucosa, historial, perfil). Puerto 8000 por defecto; si cambiaste BACKEND_PORT, usa ese.
EXPO_PUBLIC_API_URL=http://TU-IP-LOCAL:8000

# Servicio NLP (chatbot). Puerto 8001 por defecto; si cambiaste NLP_PORT en el compose, usa ese.
EXPO_PUBLIC_NLP_URL=http://TU-IP-LOCAL:8001

# Modo simulado: credenciales fijas, accesos rápidos por rol y datos locales, sin llamar a ningún servidor.
# Solo el valor "true" lo activa.
EXPO_PUBLIC_USE_MOCK=false
