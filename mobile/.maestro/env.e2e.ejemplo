# Copia este archivo como mobile/.maestro/.env.e2e.local (esta ruta esta ignorada por git) y completa SOLO cuentas de prueba.
# Nunca versiones valores reales. Tambien puedes definir estas mismas variables en el entorno de PowerShell.
PACIENTE_CORREO=
PACIENTE_CLAVE=
MEDICO_CORREO=
MEDICO_CLAVE=

# Solo suite C (escrituras reales, ADR-0013). Cuentas de PRUEBA nada más.
E2E_PACIENTE_ID=
E2E_CUENTAS_DE_PRUEBA=
# Opcionales: si (incluye el flujo C4 con Gemini real: 1 llamada) / si (exige el porcentaje de riesgo en C1)
E2E_CHAT_ACTIVO=
E2E_ESPERA_RIESGO=
# Opcional: expresión regular del nombre del paciente de prueba en la lista del médico (por defecto 'Ana Rodr.guez'; tolera tildes)
E2E_PACIENTE_NOMBRE_REGEX=
